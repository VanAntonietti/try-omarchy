--- a/bridge/linux/blip-shim
+++ b/bridge/linux/blip-shim
@@ -23,7 +23,7 @@
 # remote_bin is expanded by the MAC's shell, so keep it literal here — a bare
 # ~ or $HOME in bridge.conf would expand to the Linux home (it did).
 host=""; remote_bin='$HOME/.blip/bin'; python="python3"; key="$HOME/.ssh/blip_ed25519"
-hide_spam=""; hide_unknown=""
+hide_spam=""; hide_unknown=""; transport="ssh"
 # Parsed, not sourced: the file is data. Known keys only, quotes stripped.
 if [[ -r "$CONF" ]]; then
   while IFS= read -r line || [[ -n "$line" ]]; do
@@ -32,6 +32,7 @@
     k="${line%%=*}"; v="${line#*=}"
     v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
     case "$k" in
+      transport) transport="$v" ;;
       host) host="$v" ;;
       remote_bin) remote_bin="$v" ;;
       python) python="$v" ;;
@@ -41,6 +42,15 @@
     esac
   done < "$CONF"
 fi
+# Selection is explicit. An unavailable Link must never fall back to SSH.
+case "$transport" in
+  ssh) ;;
+  omarchy-link)
+    ulimit -c 0
+    exec bun "$(dirname "$0")/blip-link.ts" "$(basename "$0")" "$@"
+    ;;
+  *) echo 'blip: unknown transport' >&2; exit 78 ;;
+esac
 host="${BLIP_MAC_HOST:-$host}"
 if [[ -z "$host" ]]; then
   echo "blip: no Mac configured — run blip-setup (or set host= in $CONF)" >&2
